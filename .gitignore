# ============================================================
# Fichiers que Git doit ignorer.
# Une ligne = un motif. Le "/" final signifie "dossier".
# ============================================================

# Mon fichier de suivi personnel : il ne doit pas partir en ligne
SUIVI.md

# Secrets : mots de passe, clés d'API, identifiants.
# Rien de tel dans ce projet aujourd'hui, mais la règle protège l'avenir.
.env
.env.*

# Dépendances installées par npm (si un outil en génère un jour)
node_modules/

# ------------------------------------------------------------
# Outillage de design (skills Claude Code)
# ------------------------------------------------------------

# Réglages locaux de la machine
.claude/settings.local.json

# Les skills sont installés par npx et pèsent 21 Mo, dont un binaire
# Windows de 15 Mo propre à ma machine. Ils se réinstallent en deux
# commandes (voir SUIVI.md), donc ils n'ont rien à faire dans
# l'historique d'un dépôt de portfolio servi par GitHub Pages.
.claude/skills/
.claude/agents/

# Sorties éphémères d'impeccable : seuls le contexte de design et les
# rapports d'audit sont conservés.
.impeccable/
!.impeccable/config.json
!.impeccable/design.json
!.impeccable/surfaces/
!.impeccable/critique/

# Fichiers générés automatiquement par les systèmes d'exploitation
.DS_Store
Thumbs.db
desktop.ini
